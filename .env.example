# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight_dev
POSTGRES_DB=insight_navigator
DATABASE_URL=postgresql://insight:insight_dev@localhost:5432/insight_navigator

# ── Backend auth ─────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Internal job auth ─────────────────────────────────────────────────────────
# Passed as X-Internal-Secret header to /api/v1/internal/* routes
INTERNAL_SECRET=change_this_internal_secret_in_production

# ── Journal encryption ────────────────────────────────────────────────────────
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Leave empty in dev to use an insecure fallback key (Docker only)
JOURNAL_ENCRYPTION_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Mental-health risk classifier (Hugging Face Inference API) ───────────────
# Free token: https://huggingface.co/settings/tokens
# Used by SajjadIslam/multiMentalRoBERTA-6-class as an extra, unvalidated ML
# risk signal on journal entries — runs remotely, no local model download.
# Leave empty to disable; scoring degrades gracefully without it.
HF_API_TOKEN=

# ── Patient app (Expo) ────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Clinician dashboard (Vite) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
